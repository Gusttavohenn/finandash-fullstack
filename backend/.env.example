# Conexão com o banco de dados PostgreSQL (ex: Neon, Render, Supabase)
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Chave secreta para assinar os tokens JWT (use algo longo e aleatório)
JWT_SECRET=sua-chave-secreta-aqui

# Origem permitida pelo CORS (URL do seu frontend)
CORS_ORIGIN=https://nexo-financeiro.vercel.app

# Porta do servidor (opcional, padrão: 3000)
PORT=3000
